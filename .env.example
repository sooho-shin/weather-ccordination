# Server-only Hive credential. Never use an EXPO_PUBLIC_ prefix for secrets.
# Cloudflare Pages: configure HIVE_SECRET_KEY as a production encrypted secret.
# Local Metro / offline generation script: explicitly supply HIVE_SECRET_KEY.
HIVE_SECRET_KEY=your_hive_secret_key_here

# Non-secret model identifier only; web clients call the same-origin Pages proxy.
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
