# AI 연동 API 키 설정 (선택 사항)
# 설정하지 않아도 기본 0.1초 고화질 실사 프리셋과 안전 시뮬레이션 모드로 완벽하게 동작합니다.

# TheHive.ai / DeepSeek API (날씨 기반 실시간 코디 및 날씨 방어 태그 생성)
EXPO_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_or_hive_api_key_here
EXPO_PUBLIC_DEEPSEEK_BASE_URL=https://api.thehive.ai/v1
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat

# OpenAI DALL-E 3
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Fal.ai / Flux
EXPO_PUBLIC_FAL_KEY=your_fal_api_key_here
